# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug / runtime artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# local database (dev SQLite)
*.db
*.db-journal
prisma/dev.db*

# env files — commit ONLY the example template
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / build info
*.tsbuildinfo
next-env.d.ts

# uploads (dev-only avatar fallback; produksi pakai Directus Files)
/public/uploads

# generated prisma client
/src/generated/prisma

# AI agent tooling (vendored skills + design-tool cache) — restore via `npx skills add`
# (skills-lock.json IS committed so contributors can restore them)
/.agents
/.impeccable
/.claude
/.windsurf

# editor / OS
*.swp
*.tmp
tmp-*
