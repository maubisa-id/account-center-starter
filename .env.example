# Lokal (SQLite) - default untuk testing
DATABASE_URL="file:./dev.db"

# Provider engine database untuk kode aplikasi (Better Auth adapter) + guard fail-fast.
# HARUS sama dengan datasource.provider di prisma/schema.prisma dan skema DATABASE_URL.
# Nilai: "sqlite" (dev) | "mysql" (produksi) | "postgresql". Default sqlite bila kosong.
# Saat pindah MySQL: ganti provider di schema.prisma -> "mysql", DB_PROVIDER -> "mysql",
# dan DATABASE_URL -> "mysql://...". (src/lib/db-config.ts melempar error bila tak konsisten.)
DB_PROVIDER="sqlite"

# Produksi (MySQL / Cloud SQL): provider di-set otomatis ke "mysql" saat build Docker
# (scripts/db-provider.mjs membaca DB_PROVIDER). Di luar Docker: `DB_PROVIDER=mysql npm run db:setup`.
# DATABASE_URL="mysql://user:password@host:3306/account_center"

# Mode Demo: set "1" untuk menampilkan bilah "Mode Demo" di atas semua halaman (memberi tahu
# pengunjung bahwa data hanya contoh & pembayaran memakai Sandbox). Biarkan kosong di produksi.
# NEXT_PUBLIC_DEMO_MODE="1"
#
# Docker/Coolify saja: SEED_ON_START="1" mengisi data contoh (npm run seed) saat container start.
# Pakai untuk deploy demo PERTAMA, lalu boleh diubah ke "0". (Untuk docker-compose bawaan repo:
# DB_PASSWORD & DB_ROOT_PASSWORD mengatur sandi MySQL demo — lihat docker-compose.yml.)
# SEED_ON_START="1"
#
# Docker/Coolify saja: DB_PUSH_ON_START="1" membuat tabel via `prisma db push` saat start.
# DEFAULT MATI. Nyalakan HANYA untuk database KOSONG (mis. demo). JANGAN nyalakan di produksi
# yang memakai Cloud SQL bersama (maubisa_core) — skema di sana dikelola terpisah & dipakai
# layanan lain; db push bisa mengubah/menghapus kolom bersama.
# DB_PUSH_ON_START="1"

# URL layanan untuk tombol "Buka layanan" (app launcher) di halaman Akses.
# Opsional: kalau tidak diisi, default ke URL contoh di src/lib/services.ts.
# NEXT_PUBLIC_APP_URL="https://app.example.com"
# NEXT_PUBLIC_KELAS_URL="https://kelas.example.com"
# NEXT_PUBLIC_THESIS_URL="https://konsultasi.example.com"
# NEXT_PUBLIC_BOOK_URL="https://example.com/buku"
# Situs utama untuk tombol kembali di /terima-kasih (checkout tamu selesai).
# NEXT_PUBLIC_MAIN_SITE_URL="https://example.com"
#
# ── Identitas brand (semua opsional; default generik "Account Center") ────────────────────
# Isi untuk menjadikan aplikasi milik Anda tanpa menyentuh kode. Yang kosong tak dirender
# (tautan/legal/sosial hilang, bukan jadi tautan mati).
# NEXT_PUBLIC_BRAND_NAME="Account Center"
# NEXT_PUBLIC_BRAND_LEGAL_NAME="PT Example"
# NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# NEXT_PUBLIC_SUPPORT_WHATSAPP="6281234567890"      # nomor tanpa "+", untuk tombol WhatsApp email
# NEXT_PUBLIC_HELP_URL="https://help.example.com"
# NEXT_PUBLIC_PRIVACY_URL="https://example.com/privacy"
# NEXT_PUBLIC_TERMS_URL="https://example.com/terms"
# NEXT_PUBLIC_ACCEPTABLE_USE_URL="https://example.com/acceptable-use"
# NEXT_PUBLIC_TRUST_CENTER_URL="https://example.com/trust"
# NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/yourbrand"
# NEXT_PUBLIC_SOCIAL_LINKEDIN="https://linkedin.com/company/yourbrand"
# NEXT_PUBLIC_SOCIAL_TIKTOK="https://tiktok.com/@yourbrand"
# Identitas penerbit invoice (opsional; kosong = baris terkait tak dicetak).
# NEXT_PUBLIC_BRAND_ADDRESS="Jl. Contoh No. 1, Jakarta"
# NEXT_PUBLIC_BRAND_PHONE="+62 21 0000 0000"
# NEXT_PUBLIC_BRAND_TAX_ID="00.000.000.0-000.000"
#
# URL logo brand (sidebar, login, 404, invoice). Kosong = aset lokal generik /logo.svg.
# Sidebar (latar gelap) otomatis diputihkan via CSS, jadi cukup SATU logo berwarna latar
# transparan. Override hanya berlaku bila di-inject saat build (klien meng-inline NEXT_PUBLIC_*).
# NEXT_PUBLIC_LOGO_URL="https://example.com/logo.png"
# Logo untuk email (URL ABSOLUT; email tak bisa aset relatif). Kosong = email memakai nama brand
# sebagai teks. Aset ilustrasi email opsional lewat EMAIL_ASSET_BASE (host {hero,badge}-*.png).
# NEXT_PUBLIC_LOGO_DARK_URL="https://example.com/logo-email.png"
# EMAIL_ASSET_BASE="https://cdn.example.com/email"
#
# WhatsApp untuk tombol "Konsultasi" (mis. bimbingan skripsi di /langganan/ubah). Selama
# Payment Link belum aktif, konsultasi diarahkan ke WhatsApp. Cukup ganti nomor, atau
# override URL penuh (mis. pakai template pesan sendiri).
# NEXT_PUBLIC_WHATSAPP_NUMBER="62811134069"
# NEXT_PUBLIC_WHATSAPP_CONSULT_URL="https://wa.me/62811134069?text=Halo%20MinBi..."
#
# Flag "dashboard produk sudah live?" untuk peluncur "Layanan saya" di Ringkasan.
# Konsultasi default ON; app/kelas/book default OFF →
# tampil "Dashboard segera hadir" alih-alih tautan mati. Set "true" saat subdomain live.
# NEXT_PUBLIC_THESIS_ENABLED="true"
# NEXT_PUBLIC_APP_ENABLED="false"
# NEXT_PUBLIC_KELAS_ENABLED="false"
# NEXT_PUBLIC_BOOK_ENABLED="false"

# Midtrans Core API (Sandbox). Ambil dari dashboard Midtrans > Settings > Access Keys.
# Antarmuka pembayaran custom memakai Core API `/v2/charge` — bukan Snap. Metode:
# QRIS, GoPay, ShopeePay, Virtual Account (BCA/BNI/BRI/CIMB/Permata), Mandiri Bill, KARTU (3DS).
# Payment Link & Subscription API (recurring subscription) memakai
# server key yang SAMA. Core API di Sandbox aktif otomatis; untuk Production ajukan aktivasi.
# Biarkan KOSONG bila belum ada -> checkout menampilkan "belum tersedia" (bukan error kunci palsu).
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
# Client key WAJIB bila memakai Kartu Kredit/Debit (tokenisasi 3DS di browser via
# midtrans-new-3ds.min.js). QRIS/Virtual Account/e-wallet TIDAK memerlukannya.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
#
# Webhook Midtrans (SATU handler untuk semua produk): set di dashboard
#   Settings > Configuration > Payment Notification URL   = https://akun.example.com/api/webhook/midtrans
# Untuk tagihan langganan berulang (recurring subscription), set juga:
#   Recurring Notification URL = https://akun.example.com/api/webhook/midtrans
# (Handler kita idempotent + memilah recurring lewat subscription_id, jadi satu URL aman.)
# Finish Redirect URL (kembalinya pembeli setelah 3DS kartu / Payment Link):
#   Finish Redirect URL        = https://akun.example.com/bayar/selesai
# CATATAN: hapus URL WooCommerce lama (…/?wc-api=WC_Gateway_Midtrans) bila masih terpasang.
#
# (Opsional) Domain NETRAL untuk "pulang" setelah bayar — checkout TAMU (handoff §3/§4).
# Default: BETTER_AUTH_URL. Set ke origin yang melayani app ini
# (mis. https://bayar.example.com) supaya pembeli tamu tak "terdampar" di domain "akun".
# Path /bayar/selesai tetap dirender oleh app ini, jadi origin harus mengarah ke sini.
# PAYMENT_FINISH_URL="https://bayar.example.com"
#
# ── Saat masih DEV (belum pakai domain) ────────────────────────────────────
# Untuk screenshot "Payment Settings" di dashboard Midtrans:
#  • Finish Redirect URL = BOLEH http://localhost:3000/bayar/selesai (ini redirect BROWSER,
#    jadi localhost bisa dibuka di mesinmu sendiri).
#  • Payment Notification URL TIDAK bisa localhost — Midtrans (server) tak bisa menjangkau
#    localhost. Pakai tunnel publik (mis. `cloudflared tunnel --url http://localhost:3000`)
#    lalu isi Notification URL = https://<subdomain-tunnel>/api/webhook/midtrans.
#  • BI SNAP Notification URL: kosongkan (kita pakai Core API klasik, bukan BI-SNAP).

# Better Auth. Secret acak (mis. `openssl rand -base64 32`); URL = origin Pusat Akun.
BETTER_AUTH_SECRET="ganti-dengan-string-acak-panjang"
BETTER_AUTH_URL="http://localhost:3000"
# Override domain cookie sesi. Kosong = otomatis (domain induk bila BETTER_AUTH_URL memakai subdomain,
# untuk SSO lintas subdomain). Set "host" untuk cookie HOST-ONLY — WAJIB bila meng-host DEMO di
# subdomain yang sama supaya sesi demo TIDAK bertabrakan dengan
# produksi. Fork merek lain bisa isi domainnya sendiri (mis. ".contoh.id").
# AUTH_COOKIE_DOMAIN="host"

# Provisioning dari web utama (POST /api/provision). Shared secret yang dipakai
# situs utama/CMS saat mengirim data pembeli untuk membuat akun + password sekali pakai.
PROVISION_SECRET="ganti-dengan-string-acak-panjang-lain"

# Admin halaman /admin (buat Payment Link bimbingan skripsi). Daftar email admin, koma-pisah.
# TIDAK ada self-signup admin & tanpa kolom role: admin = user biasa yang emailnya kamu (owner)
# taruh di sini. Kosong = /admin tertutup (404) untuk semua. Contoh: "owner@example.com,ops@example.com".
# ADMIN_EMAILS=""

# Wajibkan verifikasi dua langkah (2FA) untuk akses /admin. Set "1" di PRODUKSI supaya admin
# tanpa 2FA dialihkan ke /keamanan (PCI DSS Req8, SOC2 CC6.6, ISO A.8.5). Kosong/0 = hanya
# tampilkan peringatan tanpa memblokir (cocok untuk DEMO). Default: tidak wajib.
# ADMIN_REQUIRE_MFA="1"

# Cloudflare Turnstile (anti-bot untuk /daftar & /masuk). Ambil dari dashboard Cloudflare >
# Turnstile > Add site. Aktif HANYA bila KEDUANYA diisi; kalau kosong, captcha dimatikan
# (fail-open) supaya dev lokal lancar. Endpoint yang dilindungi: sign-up & sign-in email.
# Untuk testing lokal, Cloudflare menyediakan kunci uji "always pass":
#   site  = 1x00000000000000000000AA   secret = 1x0000000000000000000000000000000AA
# WAJIB di PRODUKSI: kalau NODE_ENV=production tanpa TURNSTILE_SECRET_KEY, aplikasi berhenti
# saat start (fail-closed) — KECUALI build DEMO (NEXT_PUBLIC_DEMO_MODE=1), yang sengaja tanpa
# captcha supaya pengunjung tak terhalang widget eksternal (ad-blocker sering memblokirnya).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Directus (CMS) — sumber data Acara (Motion D: event gratis & berbayar).
# Kalau kosong, halaman Acara memakai contoh lokal. Token sama dgn yang dipakai web utama.
DIRECTUS_URL=""
DIRECTUS_TOKEN=""
# DIRECTUS_EVENTS_COLLECTION="events"
# Collection pendaftaran acara (SATU sumber: form website anonim + Account Center login).
# DIRECTUS_REGISTRATIONS_COLLECTION="event_registrations"
# Acara DEMO berbayar (untuk uji coba pembayaran kartu tanpa perlu event asli di Directus).
# Default: aktif di dev, mati di produksi. Set "true" untuk menyalakan di demo publik yang
# di-deploy, atau "false" untuk mematikan sepenuhnya.
# ENABLE_DEMO_EVENTS="true"
# ── Penyimpanan foto profil (avatar) — S3-compatible: GCS (prod) / R2 (demo) ──
# Satu kode, dua backend. Isi SEMUA lima var utama untuk mengaktifkan. Kalau kosong,
# jatuh ke Directus (bila diset) lalu disk lokal (dev).
#   PRODUKSI (Google Cloud Storage atau S3-compatible bucket):
#     S3_ENDPOINT="https://storage.googleapis.com"
#     S3_REGION="auto"                         # bila ditolak, isi region bucket (mis. asia-southeast2)
#     S3_BUCKET="account-center-assets"
#     S3_PUBLIC_BASE_URL="https://cdn.example.com"
#     S3_KEY_PREFIX="akun/avatars/"
#     S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY = HMAC key GCS
#       (GCP Console > Cloud Storage > Settings > Interoperability > Create key untuk service account)
#   DEMO (Cloudflare R2, bucket demo-akun-maubisa):
#     S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#     S3_REGION="auto"
#     S3_BUCKET="demo-akun-maubisa"
#     S3_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"    # r2.dev public domain bucket
#     S3_KEY_PREFIX="avatars/"
#     S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY = R2 API token S3 (Cloudflare > R2 > Manage R2 API Tokens)
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""
# S3_KEY_PREFIX="akun/avatars/"
#   Catatan: kode menambah subfolder peran + nama stabil di bawah prefix ini, jadi objek
#   akhir jadi "<prefix>{user|admin}/<slug-nama>-avatar-<user-id>.<ext>" (mis.
#   "akun/avatars/user/budi-avatar-abc123.png"). Unggah ulang menimpa berkas lama.
#
# (Opsional) id folder Directus untuk menyimpan foto profil (avatar) hasil unggah user.
# Kalau kosong, file masuk root Files. Di dev tanpa Directus/S3, avatar disimpan lokal ke
# public/uploads/avatars (jangan dipakai di serverless).
# DIRECTUS_AVATAR_FOLDER=""

# ── Aset gambar (opsional; kosong = default yang sudah ditentukan di kode) ────
# Basis URL untuk ikon pembayaran (payIcon), logo bank pada kartu (bankLogo), dan aset
# gambar di email. Kosong = pakai default di kode (lihat src/lib/pay-assets.ts). Override
# untuk melayani dari CDN/bucket sendiri (mis. hindari optimizer atau berbagi antar app).
# NEXT_PUBLIC_PAY_ICON_BASE=""
# NEXT_PUBLIC_BANK_LOGO_BASE=""
# EMAIL_ASSET_BASE=""

# Email transaksional (OTP, atur/atur-ulang kata sandi, struk pembayaran).
# Konfigurasi SMTP. Kalau kosong -> dicetak ke konsol (dev).
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_ENCRYPTION="tls"
MAIL_USERNAME=""
MAIL_PASSWORD=""
# CATATAN: MAIL_FROM_ADDRESS/NAME di bawah hanya FALLBACK dan JARANG terpakai — hampir semua
# email memakai pengirim PER-KANAL di bawahnya. Envelope MAIL FROM dipaksa ke MAIL_USERNAME
# (akun SMTP terautentikasi) supaya Gmail tidak menolak.
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Pusat Akun"
#
# Pengirim per-kanal (INI yang sebenarnya dipakai email). Default di kode:
#   akun (OTP/keamanan/reset)  -> From: Keamanan Akun <no-reply@example.com>, Reply-To: halo@example.com
#   tagihan (struk/langganan)  -> From: Tagihan <notifikasi@example.com>, Reply-To: tagihan@example.com
#   info                        -> From: Pusat Akun <notifikasi@example.com>, Reply-To: halo@example.com
# PENTING (produksi Gmail/Workspace): akun SMTP (MAIL_USERNAME) HARUS boleh "Send mail as"
# no-reply@ DAN notifikasi@ — kalau tidak, Gmail menulis ulang/menolak. Kalau relaymu hanya
# boleh 1 alamat, override ketiga kanal ke alamat itu di bawah. Reply-To cukup mailbox yang
# menerima (halo@, tagihan@).
# MAIL_FROM_AKUN="Keamanan Akun <no-reply@example.com>"
# MAIL_FROM_TAGIHAN="Tagihan <notifikasi@example.com>"
# MAIL_FROM_INFO="Pusat Akun <notifikasi@example.com>"
# MAIL_REPLYTO_AKUN="halo@example.com"
# MAIL_REPLYTO_TAGIHAN="tagihan@example.com"
# MAIL_REPLYTO_INFO="halo@example.com"

# ── Error monitoring (Sentry via @sentry/nextjs) ─────────────
# Pusat Akun pakai PROJECT SENTRY TERPISAH dari website utama (Astro) supaya error
# masing-masing tidak tercampur. Buat project baru di Sentry (Platform: Next.js),
# lalu salin DSN-nya ke sini.
#
# Konfigurasi ini "errors only": Tracing, Session Replay, dan Logs SENGAJA dimatikan
# karena masing-masing punya kuota tersendiri — mematikannya menjaga akun tetap di
# free tier (Developer plan) dan tidak akan menimbulkan tagihan.
#
# Sentry hanya aktif saat NODE_ENV=production DAN DSN di bawah terisi. Di dev lokal
# Sentry mati total (tidak membuang kuota). Kalau DSN dikosongkan, Sentry non-aktif.
#
# DSN bersifat publik (aman tampil di browser) -> pakai prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=""

# (Opsional) Label lingkungan pada event Sentry. Default "production". Set ke
# "staging" saat deploy non-produksi supaya error-nya terpisah di dashboard.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="staging"

# (Opsional, hanya untuk build/CI) Upload source map agar stack trace mudah dibaca.
# JANGAN commit token ini. Set hanya sebagai secret di CI. Tanpa token, build tetap
# jalan tanpa upload source map.
# SENTRY_ORG="pt-litera-edu-solusi"
# SENTRY_PROJECT="javascript-nextjs"
# SENTRY_AUTH_TOKEN=""